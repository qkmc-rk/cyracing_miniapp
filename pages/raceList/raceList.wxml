<!--raceList.wxml-->
<navigation-bar title="比赛列表" back="{{true}}" color="#fff" background="#000" extClass="nav-light"></navigation-bar>

<scroll-view class="race-list-scroll" scroll-y type="list" bindscrolltolower="onScrollToLower">
  <view class="race-list-page">

    <!-- 加载中（首次） -->
    <view wx:if="{{loading && races.length === 0}}" class="loading-wrap">
      <text class="loading-text">加载中…</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && races.length === 0}}" class="empty-wrap">
      <text class="empty-text">暂无比赛记录</text>
    </view>

    <!-- 比赛列表 -->
    <block wx:else>
      <view
        wx:for="{{races}}"
        wx:key="race_id"
        class="race-card"
        bindtap="onRaceTap"
        data-race-id="{{item.race_id}}"
      >
        <view class="race-card-top">
          <view class="race-tag {{item.session_class}}">{{item.session_label}}</view>
          <text class="race-card-track">{{item.track_name}}</text>
          <text class="race-card-date">{{item.date}}</text>
        </view>
        <view class="race-card-bottom">
          <text class="race-card-info">共{{item.entrants_count}}人参赛</text>
        </view>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{loadingMore}}" class="loading-more">
        <text class="loading-text">加载更多…</text>
      </view>

      <!-- 已加载全部 -->
      <view wx:elif="{{noMore}}" class="no-more">
        <text class="no-more-text">— 已加载全部 —</text>
      </view>
    </block>

  </view>
</scroll-view>