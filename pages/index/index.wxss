/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background-color: #000000;
}

/* 视频容器：填满整个页面 */
.video-banner {
  width: 100%;
  height: 200rpx;
  overflow: hidden;
  position: relative;
}

/* 视频元素：比父容器更大，居中裁剪只显示中间画面 */
.video-banner video {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 120%;
  min-height: 120%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
}

/* 半透明遮罩层 — Skyline不支持radial-gradient，用linear-gradient模拟暗角效果 */
.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.6) 40%, rgba(0,0,0,0.6) 60%, rgba(0,0,0,0.9) 100%);
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

/* 遮罩上方的黑色居中标题 */
.video-title {
  color: #cc0000;
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-align: center;
}

/* ========== 公告区块 ========== */
.block {
  width: calc(100% - 40rpx);
  margin: 20rpx 20rpx;
  background: #000000;
  border: 2rpx solid #333333;
  border-radius: 12rpx;
  overflow: hidden;
}

.block-title {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.block-title::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  background: #ff0000;
  border-radius: 50%;
  margin-right: 14rpx;
}

.block-content {
  padding: 0 10rpx 20rpx;
}

.block-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 20rpx;
  border-top: 1rpx solid #222222;
  background: #0d0d0d;
}

.block-item-title {
  font-size: 28rpx;
  color: #e0e0e0;
}

.block-item-date {
  font-size: 26rpx;
  color: #888888;
}

/* ========== 最近比赛区块 ========== */
.race-title {
  justify-content: space-between;
}

.race-more {
  font-size: 24rpx;
  color: #ff0000;
  font-weight: normal;
}

.race-title .block-title-text {
  flex: 1;
}

/* 比赛条目：两行布局 */
.race-item {
  padding: 20rpx 20rpx;
  border-top: 1rpx solid #222222;
  background: #0d0d0d;
}

.race-item-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.race-tag {
  font-size: 22rpx;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.race-tag--main {
  background: #cc0000;
}

.race-tag--quali {
  background: #444444;
  color: #aaaaaa;
}

.race-item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  flex: 1;
}

.race-item-date {
  font-size: 24rpx;
  color: #888888;
  flex-shrink: 0;
}

.race-sub {
  font-size: 24rpx;
  color: #666666;
  padding-left: 74rpx; /* 对齐到标题文字位置 */
}

.race-loading {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  display: block;
  padding: 20rpx;
}

/* ========== 立即比赛按钮 ========== */
.race-btn-wrap {
  padding: 30rpx 20rpx 10rpx;
}

.race-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #cc0000;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  height: 96rpx;
  border-radius: 12rpx;
  letter-spacing: 4rpx;
}

.race-btn-icon {
  font-size: 36rpx;
  margin-right: 14rpx;
}

.race-btn--mod {
  background: #1a1a2e;
  border: 2rpx solid #333366;
}

.race-btn-hint {
  text-align: center;
  font-size: 22rpx;
  color: #555555;
  margin-top: 12rpx;
}

/* ========== 赛历区块 ========== */
.calendar-item {
  padding: 26rpx 20rpx;
  border-top: 1rpx solid #222222;
  background: #0d0d0d;
}

.calendar-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.calendar-track-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.calendar-tag {
  font-size: 22rpx;
  color: #aaaaaa;
  background: #333333;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.calendar-time {
  font-size: 26rpx;
  color: #888888;
}

/* ========== 公告弹窗 ========== */
.modal-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.modal-wrap {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  height: 60vh;
  background: #111;
  border: 2rpx solid #333;
  border-radius: 16rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #222;
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff0000;
  flex: 1;
}

.modal-close {
  font-size: 36rpx;
  color: #666;
  padding: 4rpx 8rpx;
  line-height: 1;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-text {
  font-size: 28rpx;
  color: #ccc;
  line-height: 1.8;
  white-space: pre-wrap;
}