/**mods.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background-color: #000000;
  padding-bottom: 40rpx;
}

/* ========== 通用区块 ========== */
.block {
  width: calc(100% - 40rpx);
  margin: 20rpx 20rpx;
  background: #000000;
  border: 2rpx solid #333333;
  border-radius: 12rpx;
  overflow: hidden;
}

.block-title {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.block-title::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  background: #ff0000;
  border-radius: 50%;
  margin-right: 14rpx;
}

.block-content {
  padding: 0 10rpx 20rpx;
}

/* ========== 说明文字 ========== */
.intro-text {
  font-size: 26rpx;
  color: #888888;
  padding: 10rpx 20rpx;
  line-height: 1.6;
}

/* ========== 文件列表 ========== */
.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 20rpx;
  border-top: 1rpx solid #222222;
  background: #0d0d0d;
  transition: background 0.2s;
}

.file-item--downloading {
  background: #1a0a0a;
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.file-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.file-detail {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: 28rpx;
  color: #e0e0e0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}

.file-action {
  flex-shrink: 0;
  margin-left: 20rpx;
}

.file-download-btn {
  font-size: 26rpx;
  color: #ff0000;
  border: 2rpx solid #ff0000;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
}

.file-downloading {
  font-size: 24rpx;
  color: #888888;
}

/* ========== 加载/空状态 ========== */
.loading-text,
.empty-text {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  display: block;
  padding: 20rpx;
}

/* ========== 使用说明 ========== */
.tip-item {
  font-size: 26rpx;
  color: #888888;
  padding: 8rpx 20rpx;
  line-height: 1.8;
}
